# SupportIQ Environment Variables Example
# Copy this file to .env and fill in your values. Never commit .env to git.

# Hugging Face (for model downloads / private adapter checkpoints)
HF_TOKEN=your_huggingface_token_here

# Kaggle API (for Kaggle notebook execution if needed)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# AWS Configuration (for SageMaker / S3 / ECR in later phases)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# Or use AWS SSO / AWS_PROFILE
AWS_PROFILE=default

# S3 Buckets
S3_BUCKET_NAME=supportiq-artifacts-dev

# MLflow Tracking
MLFLOW_TRACKING_URI=./mlruns
# Optional remote tracking (e.g. DagsHub)
# MLFLOW_TRACKING_URI=https://dagshub.com/<username>/supportiq.mlflow
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# App / Service Configuration
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
